# 默认离线模拟，不会调用任何模型服务。复制为 .env 后填写。
PROVIDER=mock
# OpenRouter：设置 PROVIDER=openrouter，文字/摘要/生图/改图共用这一把密钥。
# 此模式忽略下面直连 OpenAI 的 TEXT_API_KEY / IMAGE_API_KEY 和 BASE_URL。
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
OPENROUTER_HELPER_MODEL=openai/gpt-4.1-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
DATABASE_URL=sqlite:///data/assistant.db
DATA_DIR=data
ADMIN_TOKEN=
# 留空即关闭本地模拟 HTTP 消息入口；命令行 demo 不需要此项。
DEV_TOKEN=

# 直连模式：PROVIDER=openai；compatible 用于其他兼容服务。
# 当前采用 Chat Completions 与同步 Images API。
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_MODEL=gpt-4.1-mini
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_EDIT_FORMAT=json
# 部分兼容服务需要 response_format=b64_json，按供应商文档填写。
IMAGE_EXTRA_JSON={}
TEXT_EXTRA_JSON={}
MODEL_TIMEOUT_SECONDS=180
MAX_OUTPUT_TOKENS=1600
CONTEXT_BYTE_BUDGET=8000

# 企业内部应用机器人，接收模式选择 Stream。首版只允许单聊。
DINGTALK_CORP_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_DOWNLOAD_HOSTS=dingtalk.com,alicdn.com,aliyuncs.com

# 默认个人每日文本 50 次、图片 5 次；可通过管理接口/CLI 单独调整。
DEFAULT_TEXT_LIMIT=50
DEFAULT_IMAGE_LIMIT=5
# 所有试用人员合计的每日资源点上限：文本任务 1 点，图片任务 20 点。
# 资源点不是人民币；失败/结果未知调用保留占用，避免失败重试绕过限额。
DAILY_CREDIT_LIMIT=500
# Comma-separated staff IDs in DINGTALK_CORP_ID; bypass application quotas for testing.
UNLIMITED_STAFF_IDS=
# 可选：配置保守的单任务费用预留值（分），文本值须涵盖摘要+回复。
# 0 表示未启用人民币估算预算；不能代替供应商的真实账单硬限额。
TEXT_RESERVE_FEN=0
IMAGE_RESERVE_FEN=0
DAILY_BUDGET_FEN=0
ASSET_RETENTION_DAYS=30
# 仅 Docker Compose 需要；建议使用随机的字母数字密码。
POSTGRES_PASSWORD=
